name: Manual Cleanup - 25 Oldest Runs

on:
  workflow_dispatch: # تشغيل يدوياً فقط من تبويب Actions

jobs:
  cleanup:
    runs-on: ubuntu-latest
    permissions:
      actions: write # ضروري لمنح صلاحية الحذف

    steps:
      - name: 🧹 Delete Oldest 25 Runs
        env:
          GH_TOKEN: ${{ github.token }}
          REPO: ${{ github.repository }}
        run: |
          echo "جاري البحث عن أقدم سجلات التشغيل..."
          
          # جلب قائمة IDs لآخر 25 سجل في القائمة (وهي الأقدم)
          run_ids=$(gh run list -R $REPO --limit 1000 --json databaseId --jq '.[].databaseId' | tail -n 25)

          if [ -z "$run_ids" ]; then
            echo "✅ لا توجد سجلات قديمة للحذف."
            exit 0
          fi

          echo "بدء عملية الحذف..."
          for id in $run_ids; do
            gh run delete $id -R $REPO
            echo "🗑️ تم حذف السجل: $id"
          done

          echo "✅ اكتملت المهمة بنجاح!"
